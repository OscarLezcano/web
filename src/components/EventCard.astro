---
import type { CollectionEntry } from "astro:content";
import dayjs from "dayjs";
import utc from "dayjs/plugin/utc";
import timezone from "dayjs/plugin/timezone";
import { getEventUrl } from "@/utils/getEventPaths";
import { slugifyStr } from "@/utils/slugify";
import { toTransitionName } from "@/utils/toTransitionName";
import Tag from "./Tag.astro";
import { useTranslations } from "@/i18n";
import config from "@/config";

dayjs.extend(utc);
dayjs.extend(timezone);

type Props = {
  variant?: "h2" | "h3";
} & CollectionEntry<"events">;

const { variant: Heading = "h2", id, data, filePath } = Astro.props;
const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const { title, date, description, location, time, mode, tags } = data;

const datetime = date
  ? dayjs(date).tz(data.timezone ?? config.site.timezone)
  : null;
---

<li class="my-6">
  <a
    href={getEventUrl(id, filePath, locale)}
    class:list={[
      "text-accent inline-block text-lg font-medium",
      "decoration-dashed underline-offset-4 hover:underline",
      "focus-visible:no-underline focus-visible:underline-offset-0",
    ]}
  >
    <Heading transition:name={toTransitionName(title)}>{title}</Heading>
  </a>

  {
    (datetime || time || location || mode) && (
      <div class="text-muted-foreground flex flex-wrap items-center gap-x-4 gap-y-1 text-sm">
        {datetime && (
          <time
            class="flex items-center gap-1"
            datetime={datetime.toISOString()}
          >
            {datetime.format("D MMM, YYYY")}
          </time>
        )}
        {time && <span>{time}</span>}
        {location && <span>{location}</span>}
        {mode && (
          <span class="border-foreground rounded border border-dashed px-1.5 py-0.5 text-xs">
            {t.event.mode[mode]}
          </span>
        )}
      </div>
    )
  }

  {description && <p>{description}</p>}

  <!-- {tags && tags.length > 0 && (
  <ul class="mt-2 flex flex-wrap gap-x-4 gap-y-1">
    {tags.map(tag => <Tag tag={slugifyStr(tag)} tagName={tag} size="sm" />)}
    </ul>
  )} -->
</li>
